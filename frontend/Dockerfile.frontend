# Frontend Dockerfile
FROM node:20-slim

WORKDIR /app

# Copiar package.json e package-lock.json
COPY package*.json ./

# Instalar dependências
RUN npm install

# Copiar o restante do código
COPY . .

# Expor a porta do Vite
EXPOSE 5173

# Rodar em modo dev com host aberto para o Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
