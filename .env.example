# ── Modelos ───────────────────────────────────────────────────────────────────
LLM_MODEL=Qwen3-8B-Q4_K_M.gguf
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0.gguf

# ── Diretório local com os arquivos .gguf ─────────────────────────────────────
MODELS_DIR=D:/models

# ── Segurança ─────────────────────────────────────────────────────────────────
SECRET_KEY=troque_por_uma_chave_segura

# ── Parâmetros do LLM ─────────────────────────────────────────────────────────
